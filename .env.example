# Prismic
# Repository name is set in prismic.config.json

# Shopify
SHOPIFY_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_PRIVATE_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Formspark
NUXT_PUBLIC_FORMSPARK_FORM_ID=

# Cloudinary — reference-image uploads on the Cotizar form.
# Formspark rejects file bodies and stores only links, so images are uploaded
# straight from the browser with an UNSIGNED upload preset and the resulting
# URLs are submitted instead. Both values are public by design; restrict the
# preset (images only, size cap, dedicated folder) in the Cloudinary console.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
